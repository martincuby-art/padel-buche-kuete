rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cualquiera que haya iniciado sesión anónima en la app (todos los
    // usuarios reales de la app, ya que la app siempre loguea anónimamente
    // antes de mostrar la pantalla de login propia) puede leer y escribir.
    // Esto es equivalente en seguridad a lo que ya tenían: no hay
    // contraseñas robustas, es una app para un grupo de amigos, no para
    // datos sensibles.
    match /players/{playerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /matches/{matchId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /news/{newsId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }
  }
}
